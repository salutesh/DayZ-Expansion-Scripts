GridSpacerWidgetClass PartyMemberEntry {
 clipchildren 0
 ignorepointer 1
 position 0 0
 size 1 28
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scriptclass "ExpansionPartyHudMemberController"
 style Colorable
 Padding 0
 Margin 0
 "Size To Content H" 1
 "Size To Content V" 1
 Rows 1
 {
  PanelWidgetClass PlayerStats {
   visible 1
   clipchildren 0
   ignorepointer 1
   size 150 28
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   priority 1
   style blank
   {
    TextWidgetClass PlayerName {
     clipchildren 1
     ignorepointer 1
     size 0.6 13
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 1
     scriptclass "ViewBinding"
     text "Player Name"
     font "gui/fonts/sdf_metronlight24"
     "exact text" 0
     "size to text h" 0
     "size to text v" 0
     {
      ScriptParamsClass {
       Binding_Name "PlayerName"
      }
     }
    }
    TextWidgetClass PlayerDistance {
     visible 1
     clipchildren 1
     ignorepointer 1
     size 0.4 13
     halign right_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 1
     scriptclass "ViewBinding"
     text "100m"
     font "gui/fonts/sdf_metronlight24"
     "exact text" 0
     "size to text h" 0
     "size to text v" 0
     "text halign" right
     {
      ScriptParamsClass {
       Binding_Name "PlayerDistance"
      }
     }
    }
    PanelWidgetClass PlayerHealthPanel {
     clipchildren 0
     ignorepointer 1
     position 0 6
     size 1 5
     halign center_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     {
      ProgressBarWidgetClass PlayerHealth {
       clipchildren 0
       ignorepointer 1
       color 0.1529 0.6824 0.3765 1
       size 1 1
       halign center_ref
       valign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 0
       scriptclass "ViewBinding"
       style Stamina
       {
        ScriptParamsClass {
         Debug_Logging 0
         Binding_Name "PlayerHealth"
        }
       }
      }
     }
    }
    PanelWidgetClass PlayerBloodPanel {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 1
     size 1 5
     halign center_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     {
      ProgressBarWidgetClass PlayerBlood {
       clipchildren 0
       ignorepointer 1
       color 1 0 0.0118 1
       size 1 1
       halign center_ref
       valign center_ref
       hexactpos 0
       vexactpos 1
       hexactsize 0
       vexactsize 0
       scriptclass "ViewBinding"
       style Stamina
       {
        ScriptParamsClass {
         Debug_Logging 0
         Binding_Name "PlayerBlood"
        }
       }
      }
     }
    }
   }
  }
  WrapSpacerWidgetClass PlayerStances {
   visible 1
   disabled 0
   clipchildren 0
   ignorepointer 1
   size 32 28
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   priority 2
   Padding 0
   Margin 0
   content_halign right
   content_valign center
   {
    ImageWidgetClass Stance {
     visible 1
     clipchildren 0
     size 28 28
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     draggable 0
     image0 "set:dayz_gui image:stance_stand"
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     "stretch mode" stretch_w_h
     filter 1
     nocache 0
    }
   }
  }
