FrameWidgetClass AircraftMarkers {
 ignorepointer 1
 clipchildren 0
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactsize 0
 vexactsize 0
 {
  ImageWidgetClass WaterlineMarker
  {
   position 0 0
   size 64 64
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   image0 "set:ccgui_enforce image:HudCrosshairLaser"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  ImageWidgetClass FlightPathMarker
  {
   position 0 0
   size 64 64
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   image0 "set:ccgui_enforce image:HudCrosshairGrenade"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
 }
}